# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
*.tsbuildinfo

# Compiled output only. NOT anchored, because every package produces its own — but
# `apps/desktop/build/` is source: icons, entitlements and the NSIS script.
build/
!apps/desktop/build/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Runtime data (never commit user data or models)
#
# Leading slash on every one of these. Without it git matches the name at *any* depth, and
# these are ordinary words: `runtime/` silently excluded `apps/server/src/modules/runtime/`
# (the GPU probe, the installer, the wheel index — eighteen source files), and `logs/` did the
# same to `apps/web/src/features/logs/`. Nothing complained; the code simply was not in the
# repository, and only turned up when somebody cloned it onto another machine.
#
# The application's data directory lives outside the repo anyway, so anchoring loses nothing.
/runtime/
/data/
/logs/
*.db
*.db-shm
*.db-wal
*.log

# Bundled binaries fetched at build time. Run `node deploy/fetch-uv.mjs` after cloning.
# One directory per architecture — see the comment in deploy/fetch-uv.mjs.
vendor/uv-*/

# Internal notes and working material — not part of what the project distributes.
#
# Anchored with a leading slash, like the runtime directories above and for the same reason:
# unanchored, `docs/` would also swallow a `docs/` folder inside any package. These two are
# specifically the ones at the repository root.
#
# Nothing here is required by the AGPL — the licence covers the source that produces the
# binary, not the working notes beside it.
/docs/
/_resources/

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local env
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/
