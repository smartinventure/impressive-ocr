# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Local build secrets. Copy to `.env.local` beside this file and fill in what you have:
#
#   cp deploy/.env.local.example deploy/.env.local
#
# `deploy/.env.local` is gitignored and must never be committed. This example file carries no
# values and is committed on purpose, so the variable names are discoverable without asking.
#
# Everything here is optional. `build-local` runs without any of it and produces working,
# unsigned artifacts that report they cannot reach the licence server — fine for testing the
# build itself, not for shipping to anyone.

# --- Licence configuration --------------------------------------------------------------
#
# Baked into the binary at build time so a fresh install reaches the registration screen
# without the user being told two more environment variables. These identify the *build*,
# not a customer, and are public once the app ships — but a key committed to a public
# repository is scraped and burned before the release it belongs to is out.

IMPRESSIVE_OCR_PRODUCT_COMMUNITY=impressiveocrcommunity
IMPRESSIVE_OCR_PRODUCT_COMMERCIAL=impressiveocrcommercial
IMPRESSIVE_OCR_INSTALLER_KEY_COMMUNITY=
IMPRESSIVE_OCR_INSTALLER_KEY_COMMERCIAL=

# --- Windows code signing (Azure Trusted Signing) ---------------------------------------
#
# All seven are needed together. With any of them missing the Windows build is produced
# unsigned, which installs and runs but triggers SmartScreen.

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SIGNING_ENDPOINT=
AZURE_CODE_SIGNING_ACCOUNT=
AZURE_CERT_PROFILE=
AZURE_PUBLISHER_NAME=

# --- macOS signing and notarisation -----------------------------------------------------
#
# Only read on a macOS host; electron-builder cannot sign or notarise a mac app from
# anywhere else. CSC_LINK is the base64 of your Developer ID .p12, or a path to it.
#
# Signing and notarisation are two separate things and you need both. A signed but
# un-notarised app runs on the machine that built it and is blocked by Gatekeeper on every
# machine that downloads it.

CSC_LINK=
CSC_KEY_PASSWORD=

# App Store Connect team API key, which is what notarytool authenticates with.
# APPLE_API_KEY_FILE is a path to the .p8; the build script exports it as APPLE_API_KEY.
APPLE_API_KEY_FILE=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_TEAM_ID=

# DO NOT also set APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD. electron-builder checks those
# first and, if either is present, commits to that path and throws when the rest is
# missing -- so they silently take precedence over the API key above.
