# Copy to dev/dev.env and edit. Loaded by both dev.ps1 and dev.sh on every run.
# dev.env is gitignored, so your local paths stay out of the repository.
#
# Format is KEY=VALUE. No quotes, no export, no variable expansion - values are
# taken verbatim, so a Windows path with backslashes and spaces is fine as-is.

# Where the database, logs and the whole OCR runtime live.
# Defaults to a sibling of the repository, which keeps the multi-GB model weights
# on the same drive as your checkout instead of on C:.
#IMPRESSIVE_OCR_DATA_DIR=D:\ocr-data

# Port for the API. Must be 1024-65535, default 8084.
# Changing it also means changing BACKEND_PORT in apps/web/vite.config.ts, since
# the web dev server proxies /api there.
#IMPRESSIVE_OCR_PORT=8084

# Path to the uv binary that builds the Python runtime.
# Defaults to <repo>/vendor/uv-<arch>/uv.exe (or .../uv). vendor/ is gitignored and
# fetched at build time, so set this if yours lives elsewhere.
#IMPRESSIVE_OCR_UV_BINARY=C:\tools\uv\uv.exe
